<section class="aiimg-gen">
  {{#unless hasKey}}
  <p class="aiimg-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "AIIMG.Gen.NoKey"}} ({{providerLabel}})</p>
  {{/unless}}
  {{#unless configured}}
  <p class="aiimg-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "AIIMG.Gen.NotConfigured"}}
    <button type="button" class="link" data-action="openConfig">{{localize "AIIMG.Gen.OpenConfig"}}</button></p>
  {{/unless}}

  <div class="form-group stacked aiimg-desc">
    <div class="aiimg-desc-head">
      <label for="{{descId}}">{{localize "AIIMG.Gen.Description"}}</label>
      <div class="aiimg-enhance" data-role="enhance"></div>
    </div>
    <textarea id="{{descId}}" name="description" rows="5" placeholder="{{localize 'AIIMG.Gen.Placeholder'}}" {{#if busy}}disabled{{/if}}>{{description}}</textarea>
    <p class="aiimg-enhance-status" data-role="enhanceStatus" role="status" aria-live="polite" hidden></p>
  </div>

  <div class="aiimg-extra-refs">
    <div class="aiimg-extra-head">
      <label>{{localize "AIIMG.Gen.ExtraRefs"}}</label>
      <button type="button" data-action="addRefs" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-image"></i> {{localize "AIIMG.Gen.AddImages"}}</button>
      <input type="file" name="refFiles" accept="image/*" multiple hidden>
    </div>
    {{#if extraRefs.length}}
    <div class="aiimg-extra-list">
      {{#each extraRefs}}
      <div class="aiimg-extra-ref" data-tooltip-text="{{name}}">
        <img src="{{url}}" alt="{{name}}">
        <button type="button" data-action="removeRef" data-uid="{{uid}}" aria-label="{{localize 'AIIMG.Gen.RemoveRef'}}" {{#if ../busy}}disabled{{/if}}><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{#if canSaveRef}}
    <label class="aiimg-saveref"><input type="checkbox" name="saveRef" {{#if saveRef}}checked{{/if}} {{#if busy}}disabled{{/if}}> {{localize "AIIMG.Gen.SaveRef"}}</label>
    {{/if}}
    <p class="notes">{{localize "AIIMG.Gen.ExtraRefsHint" mb=maxMb}}</p>
    {{#if refsOver}}<p class="aiimg-error"><i class="fa-solid fa-circle-xmark"></i> {{localize "AIIMG.Gen.TooManyRefs" total=refsTotal max=maxRefs}}</p>{{/if}}
  </div>

  <div class="aiimg-versions">
    <label class="aiimg-versions-count"><span>{{localize "AIIMG.Gen.Versions"}}</span>
      <input type="number" name="count" min="1" max="{{maxVersions}}" step="1" value="{{count}}" {{#if busy}}disabled{{/if}}></label>
    {{#if canTransparent}}
    <label class="aiimg-preview-opt"><input type="checkbox" name="transparent" {{#if transparent}}checked{{/if}} {{#if busy}}disabled{{/if}}> {{localize "AIIMG.Gen.Transparent"}}</label>
    {{/if}}
    {{#if showPreview}}
    <label class="aiimg-preview-opt"><input type="checkbox" name="preview" {{#if preview}}checked{{/if}} {{#if busy}}disabled{{/if}}> {{localize "AIIMG.Gen.PreviewFirst"}}</label>
    {{/if}}
  </div>

  <details class="aiimg-prompt" {{#if promptOpen}}open{{/if}}>
    <summary>{{localize "AIIMG.Gen.FinalPrompt"}} <span class="aiimg-prompt-chars">{{localize "AIIMG.Gen.PromptChars" n=promptChars}}</span></summary>
    <pre class="aiimg-prompt-text">{{prompt}}</pre>
    <p class="aiimg-warn aiimg-prompt-empty" {{#unless promptEmpty}}hidden{{/unless}}><i class="fa-solid fa-triangle-exclamation"></i> {{localize "AIIMG.Gen.EmptyPrompt"}}</p>
    <div class="aiimg-prompt-meta">
      <button type="button" data-action="copyPrompt"><i class="fa-solid fa-copy"></i> {{localize "AIIMG.Gen.Copy"}}</button>
    </div>
  </details>

  <dl class="aiimg-summary">
    <dt>{{localize "AIIMG.Config.Provider"}}</dt><dd>{{providerLabel}}</dd>
    <dt>{{localize "AIIMG.Config.Model"}}</dt><dd>{{modelLabel}}</dd>
    <dt>{{localize "AIIMG.Config.Resolution"}}</dt><dd>{{cfg.width}}×{{cfg.height}}</dd>
    <dt>{{localize "AIIMG.Config.Refs"}}</dt><dd>{{refsTotal}} / {{maxRefs}}</dd>
    <dt>{{localize "AIIMG.Gen.SavedAs"}}</dt><dd>{{outputSummary}}</dd>
    <dt>{{localize "AIIMG.Gen.Estimate"}}</dt>
    <dd>{{localize "AIIMG.Fast"}} {{estFast}}{{#if estFastTag}} ({{estFastTag}}){{/if}}{{#if estBatch}} · {{localize "AIIMG.BatchShort"}} {{estBatch}}{{#if estBatchTag}} ({{estBatchTag}}){{/if}}{{/if}}{{#if estTag}} · {{estTag}}{{/if}}</dd>
  </dl>

  {{#if error}}<p class="aiimg-error"><i class="fa-solid fa-circle-xmark"></i> {{error}}</p>{{/if}}

  <footer class="aiimg-footer">
    <button type="button" data-action="runFast" class="{{#if fastDefault}}primary{{/if}}" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid {{#if busyFast}}fa-spinner fa-spin{{else}}fa-bolt{{/if}}"></i> {{localize "AIIMG.Fast"}}
    </button>
    <span {{#unless canBatch}}data-tooltip="AIIMG.Gen.NoBatchTip"{{/unless}}>
      <button type="button" data-action="runBatch" class="{{#if batchDefault}}primary{{/if}}" {{#if batchDisabled}}disabled{{/if}}>
        <i class="fa-solid {{#if busyBatch}}fa-spinner fa-spin{{else}}fa-layer-group{{/if}}"></i> {{localize "AIIMG.Batch"}}
      </button>
    </span>
  </footer>
</section>
