<section class="aiimg-gen">
  {{#unless hasKey}}
  <p class="aiimg-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "AIIMG.Gen.NoKey"}} ({{providerLabel}})</p>
  {{/unless}}
  {{#unless configured}}
  <p class="aiimg-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "AIIMG.Gen.NotConfigured"}}
    <a data-action="openConfig">{{localize "AIIMG.Gen.OpenConfig"}}</a></p>
  {{/unless}}

  <div class="form-group stacked">
    <label>{{localize "AIIMG.Gen.Description"}}</label>
    <textarea name="description" rows="5" placeholder="{{localize 'AIIMG.Gen.Placeholder'}}" {{#if busy}}disabled{{/if}}>{{description}}</textarea>
  </div>

  <div class="aiimg-extra-refs">
    <div class="aiimg-extra-head">
      <label>{{localize "AIIMG.Gen.ExtraRefs"}}</label>
      <button type="button" data-action="addRefs" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-image"></i> {{localize "AIIMG.Gen.AddImages"}}</button>
      <input type="file" name="refFiles" accept="image/*" multiple hidden>
    </div>
    {{#if extraRefs.length}}
    <div class="aiimg-extra-list">
      {{#each extraRefs}}
      <div class="aiimg-extra-ref" data-tooltip="{{name}}">
        <img src="{{url}}" alt="{{name}}">
        <button type="button" data-action="removeRef" data-uid="{{uid}}" aria-label="{{localize 'AIIMG.Gen.RemoveRef'}}" {{#if ../busy}}disabled{{/if}}><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
    </div>
    {{/if}}
    <p class="notes">{{localize "AIIMG.Gen.ExtraRefsHint" mb=maxMb}}</p>
    {{#if refsOver}}<p class="aiimg-error"><i class="fa-solid fa-circle-xmark"></i> {{localize "AIIMG.Gen.TooManyRefs" total=refsTotal max=maxRefs}}</p>{{/if}}
  </div>

  <div class="aiimg-versions">
    <label for="aiimg-count">{{localize "AIIMG.Gen.Versions"}}</label>
    <input id="aiimg-count" type="number" name="count" min="1" max="{{maxVersions}}" step="1" value="{{count}}" {{#if busy}}disabled{{/if}}>
    {{#if showPreview}}
    <label class="aiimg-preview-opt"><input type="checkbox" name="preview" {{#if preview}}checked{{/if}} {{#if busy}}disabled{{/if}}> {{localize "AIIMG.Gen.PreviewFirst"}}</label>
    {{/if}}
  </div>

  <dl class="aiimg-summary">
    <dt>{{localize "AIIMG.Config.Provider"}}</dt><dd>{{providerLabel}}</dd>
    <dt>{{localize "AIIMG.Config.Model"}}</dt><dd>{{modelLabel}}</dd>
    <dt>{{localize "AIIMG.Config.Resolution"}}</dt><dd>{{cfg.width}}×{{cfg.height}}</dd>
    <dt>{{localize "AIIMG.Config.Refs"}}</dt><dd>{{refsTotal}} / {{maxRefs}}</dd>
    <dt>{{localize "AIIMG.Gen.Estimate"}}</dt>
    <dd>Fast {{estFast}}{{#if estBatch}} · Batch {{estBatch}}{{/if}}</dd>
  </dl>

  {{#if error}}<p class="aiimg-error"><i class="fa-solid fa-circle-xmark"></i> {{error}}</p>{{/if}}

  <footer class="aiimg-footer">
    <button type="button" data-action="runFast" class="{{#if fastDefault}}primary{{/if}}" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid {{#if busyFast}}fa-spinner fa-spin{{else}}fa-bolt{{/if}}"></i> {{localize "AIIMG.Fast"}}
    </button>
    <span {{#unless canBatch}}data-tooltip="AIIMG.Gen.NoBatchTip"{{/unless}}>
      <button type="button" data-action="runBatch" class="{{#if batchDefault}}primary{{/if}}" {{#if batchDisabled}}disabled{{/if}}>
        <i class="fa-solid {{#if busyBatch}}fa-spinner fa-spin{{else}}fa-layer-group{{/if}}"></i> {{localize "AIIMG.Batch"}}
      </button>
    </span>
  </footer>
</section>
