{{#*inline "sliderRow"}}
<div class="aiimg-field aiimg-range">
  <label class="aiimg-lbl" for="{{id}}">{{label}}</label>
  <div class="aiimg-range-row">
    <input id="{{id}}" type="range" name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}" data-fmt="{{fmt}}" {{#if hint}}aria-describedby="{{id}}-hint"{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
    <output for="{{id}}" data-role="rangeVal">{{text}}</output>
  </div>
  {{#if hint}}<p class="hint" id="{{id}}-hint">{{hint}}</p>{{/if}}
</div>
{{/inline}}
<section class="aiimg-layout">
  <nav class="aiimg-types">
    <div class="aiimg-filters">
      {{#each filters}}
      <button type="button" data-action="filter" data-group="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>
      {{/each}}
    </div>
    <ul>
      {{#each types}}
      <li>
        <button type="button" data-action="selectType" data-key="{{key}}" class="{{#if active}}active{{/if}}">
          <span class="aiimg-type-label">{{label}}</span>
          {{#if @root.showGroup}}<small>{{group}}</small>{{/if}}
          {{#if configured}}<i class="fa-solid fa-check" data-tooltip="AIIMG.Config.Configured" role="img" aria-label="{{localize 'AIIMG.Config.Configured'}}"></i>{{/if}}
        </button>
      </li>
      {{/each}}
    </ul>
    <div class="aiimg-usage">
      <i class="fa-solid fa-coins"></i>
      {{localize "AIIMG.Config.Usage"}}: {{usage.day}} / {{usage.month}} USD
    </div>
  </nav>

  <form class="aiimg-form" autocomplete="off" onsubmit="return false">
    {{#if selected}}
    <h2>{{selected.label}} <small>{{selected.group}}</small></h2>

    {{!-- W6-G: tabs. Both panels stay in the form (hidden, not removed), so a save always carries image and depth. --}}
    <div class="aiimg-tabs" role="tablist" aria-label="{{localize 'AIIMG.Tabs.Label'}}">
      {{#each tabs}}
      <button type="button" role="tab" id="aiimg-tab-{{id}}" data-tab="{{id}}" aria-controls="aiimg-panel-{{id}}"
        aria-selected="{{#if active}}true{{else}}false{{/if}}" tabindex="{{#if active}}0{{else}}-1{{/if}}" class="aiimg-tab{{#if active}} active{{/if}}">
        <i class="{{icon}}" aria-hidden="true"></i> <span>{{label}}</span>{{#if badge}} <em class="aiimg-tag">{{badge}}</em>{{/if}}
      </button>
      {{/each}}
    </div>

    <div class="aiimg-tabpanel" role="tabpanel" id="aiimg-panel-image" aria-labelledby="aiimg-tab-image" data-tab="image" {{#unless tabImage}}hidden{{/unless}}>
    <div class="aiimg-cols">
      <div class="aiimg-col">
        <section class="aiimg-card" aria-labelledby="aiimg-c-model">
          <h3 id="aiimg-c-model">{{localize "AIIMG.Config.CardModel"}}</h3>

          <div class="aiimg-field">
            <span class="aiimg-lbl" id="aiimg-l-provider">{{localize "AIIMG.Config.Provider"}}</span>
            <div class="aiimg-seg" role="radiogroup" aria-labelledby="aiimg-l-provider">
              {{#each providerList}}
              <label class="aiimg-seg-item">
                <input type="radio" name="provider" value="{{id}}" {{#if selected}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}{{#if noBatch}} <em class="aiimg-tag">{{localize "AIIMG.Config.NoBatchTag"}}</em>{{/if}}</span>
              </label>
              {{/each}}
            </div>
          </div>

          <div class="aiimg-field">
            <label class="aiimg-lbl" for="aiimg-model">{{localize "AIIMG.Config.Model"}}</label>
            <select id="aiimg-model" name="model" {{#unless isGM}}disabled{{/unless}}>
              {{#each models}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            {{#if modelInfo}}<p class="aiimg-model-info" data-role="modelInfo">{{modelInfo}}</p>{{/if}}
            {{#if retiredNote}}<p class="aiimg-size-note" data-role="retiredNote" role="status">{{retiredNote}}</p>{{/if}}
          </div>

          <div class="aiimg-field aiimg-res">
            <span class="aiimg-lbl" id="aiimg-l-size">{{localize "AIIMG.Config.Resolution"}}</span>
            <div class="aiimg-seg wrap" role="radiogroup" aria-labelledby="aiimg-l-size">
              {{#each sizes}}
              <label class="aiimg-seg-item" {{#if tip}}data-tooltip-text="{{tip}}"{{/if}}>
                <input type="radio" name="size" value="{{id}}" {{#if selected}}checked{{/if}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
              {{#if allowCustomSize}}
              <label class="aiimg-seg-item">
                <input type="radio" name="size" value="custom" {{#if customSize}}checked{{/if}}>
                <span>{{localize "AIIMG.Config.Custom"}}</span>
              </label>
              {{/if}}
            </div>
            <div class="aiimg-res-row">
              {{#if customSize}}
              <span class="aiimg-wh">
                <input type="number" name="width" value="{{cfg.width}}" min="64" max="{{sizeMax}}" step="{{sizeStep}}" aria-label="{{localize 'AIIMG.Config.Width'}}">
                <span>×</span>
                <input type="number" name="height" value="{{cfg.height}}" min="64" max="{{sizeMax}}" step="{{sizeStep}}" aria-label="{{localize 'AIIMG.Config.Height'}}">
              </span>
              {{/if}}
              {{#if aspect}}
              <div class="aiimg-aspect" data-role="aspect" role="img" aria-label="{{aspect.aria}}">
                <span class="aiimg-aspect-box"><i data-role="aspectRect" style="width:{{aspect.pw}}px;height:{{aspect.ph}}px"></i></span>
                <span class="aiimg-aspect-text"><strong data-role="aspectText">{{aspect.text}}</strong><small data-role="aspectDec">{{aspect.decText}}</small></span>
              </div>
              {{/if}}
              {{#if sizeNote}}<span class="aiimg-size-note" data-role="sizeNote" role="status">{{sizeNote}}</span>{{/if}}
            </div>
            {{#if exactSize}}<p class="hint">{{localize "AIIMG.Config.SizeRules"}}</p>{{/if}}
          </div>

          {{#if isOpenAI}}
          <div class="aiimg-field">
            <span class="aiimg-lbl" id="aiimg-l-quality">{{localize "AIIMG.Config.Quality"}}</span>
            <div class="aiimg-seg wrap" role="radiogroup" aria-labelledby="aiimg-l-quality">
              {{#each qualities}}
              <label class="aiimg-seg-item{{#if disabled}} is-off{{/if}}" {{#if disabled}}data-tooltip="AIIMG.Config.NotForModel"{{/if}}>
                <input type="radio" name="quality" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
          </div>
          {{/if}}

          {{#if canTransparent}}
          <div class="aiimg-field">
            <label class="aiimg-check">
              <input type="checkbox" name="transparent" {{#if transparent}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
              <span>{{localize "AIIMG.Config.Transparent"}}</span>
            </label>
            <p class="hint">{{localize "AIIMG.Config.TransparentHint"}}</p>
          </div>
          {{/if}}
          {{#if transparentNote}}<p class="aiimg-size-note" role="status">{{transparentNote}}</p>{{/if}}

          {{#if isGemini}}
          <div class="aiimg-field">
            <span class="aiimg-lbl" id="aiimg-l-isize">{{localize "AIIMG.Config.ImageSize"}}</span>
            <div class="aiimg-seg" role="radiogroup" aria-labelledby="aiimg-l-isize">
              {{#each imageSizes}}
              <label class="aiimg-seg-item{{#if disabled}} is-off{{/if}}" {{#if disabled}}data-tooltip="AIIMG.Config.NotForModel"{{/if}}>
                <input type="radio" name="imageSize" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
          </div>
          <div class="aiimg-field">
            <span class="aiimg-lbl" id="aiimg-l-think">{{localize "AIIMG.Config.Thinking"}}</span>
            {{#if hasThinking}}
            <div class="aiimg-seg" role="radiogroup" aria-labelledby="aiimg-l-think">
              {{#each thinkingLevels}}
              <label class="aiimg-seg-item{{#if disabled}} is-off{{/if}}" {{#if disabled}}data-tooltip="AIIMG.Config.NotForModel"{{/if}}>
                <input type="radio" name="thinkingLevel" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
            {{else}}
            <p class="hint">{{localize "AIIMG.Config.ThinkingFixed"}}</p>
            {{/if}}
          </div>
          {{/if}}

          <p class="aiimg-est" role="status"><i class="fa-solid fa-coins" aria-hidden="true"></i> <span data-role="estPer">{{estPer}}</span></p>
          {{#if breakdown}}
          <div class="aiimg-est-detail">
            <p class="aiimg-est-lines" role="status" aria-live="polite"><span class="aiimg-est-tag">{{localize "AIIMG.Est.Tag"}}</span> <span data-role="estLines">{{#each breakdown.lines}}{{#unless @first}} · {{/unless}}{{this}}{{/each}}</span></p>
            <p class="aiimg-est-hint" data-role="estHint" role="status" {{#unless breakdown.hint}}hidden{{/unless}}><i class="fa-solid fa-lightbulb" aria-hidden="true"></i> {{breakdown.hint}}</p>
            <p class="hint">{{localize "AIIMG.Est.Source"}}</p>
          </div>
          {{/if}}
        </section>

        <section class="aiimg-card" aria-labelledby="aiimg-c-mode">
          <h3 id="aiimg-c-mode">{{localize "AIIMG.Config.Mode"}}</h3>
          <div class="aiimg-seg" role="radiogroup" aria-labelledby="aiimg-c-mode">
            <label class="aiimg-seg-item">
              <input type="radio" name="defaultMode" value="fast" {{#if isFast}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
              <span>{{localize "AIIMG.Fast"}}</span>
            </label>
            <label class="aiimg-seg-item{{#unless supportsBatch}} is-off{{/unless}}">
              <input type="radio" name="defaultMode" value="batch" {{#if isBatch}}checked{{/if}} {{#unless supportsBatch}}disabled{{/unless}} {{#unless isGM}}disabled{{/unless}}>
              <span>{{localize "AIIMG.Batch"}}</span>
            </label>
          </div>
          <div class="aiimg-field aiimg-count">
            <label for="aiimg-default-count">{{localize "AIIMG.Config.DefaultCount"}}</label>
            <input type="number" id="aiimg-default-count" name="defaultCount" min="1" max="8" step="1" value="{{defaultCount}}" {{#unless isGM}}disabled{{/unless}}>
          </div>
          {{#unless supportsBatch}}<p class="aiimg-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize noBatchKey}}</p>{{/unless}}
          {{#if batchWarn}}<p class="aiimg-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize batchFallbackKey}}</p>{{/if}}
        </section>
      </div>

      <div class="aiimg-col">
        <section class="aiimg-card aiimg-output" aria-labelledby="aiimg-c-out">
          <h3 id="aiimg-c-out">{{localize "AIIMG.Config.Output"}}</h3>
          <div class="aiimg-field">
            <span class="aiimg-lbl" id="aiimg-l-edge">{{localize "AIIMG.Config.OutMaxEdge"}}</span>
            <p class="hint">{{localize "AIIMG.Config.OutMaxEdgeHint"}}</p>
            <div class="aiimg-seg wrap" role="radiogroup" aria-labelledby="aiimg-l-edge">
              {{#each outEdges}}
              <label class="aiimg-seg-item{{#if noop}} is-noop{{/if}}" {{#if noop}}data-tooltip="AIIMG.Config.OutNoEffect"{{/if}}>
                <input type="radio" name="outMaxEdge" value="{{value}}" {{#if selected}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
            <p class="aiimg-out-prev" data-role="outPrev" data-state="{{outPrev.state}}" role="status">{{outPrev.text}}</p>
          </div>
          <div class="aiimg-field">
            <span class="aiimg-lbl" id="aiimg-l-fmt">{{localize "AIIMG.Config.OutFormat"}}</span>
            <div class="aiimg-seg" role="radiogroup" aria-labelledby="aiimg-l-fmt">
              {{#each outFormats}}
              <label class="aiimg-seg-item{{#if disabled}} is-off{{/if}}" {{#if disabled}}data-tooltip="AIIMG.Config.NoAlpha"{{/if}}>
                <input type="radio" name="outFormat" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
          </div>
          <div class="aiimg-field aiimg-range">
            <label class="aiimg-lbl" for="aiimg-outq">{{localize "AIIMG.Config.OutQuality"}}</label>
            <div class="aiimg-range-row">
              <input id="aiimg-outq" type="range" name="outQualityPct" value="{{outQualityPct}}" min="50" max="100" step="5" {{#unless isGM}}disabled{{/unless}} {{#if outLossless}}disabled{{/if}}>
              <output data-role="outQualityVal" for="aiimg-outq">{{outQualityPct}}%</output>
            </div>
          </div>
          <p class="hint">{{#if outOn}}<em>{{outVia}}</em>{{else}}<strong>{{localize "AIIMG.Config.OutOff"}}</strong>{{/if}}</p>
        </section>

        <section class="aiimg-card" aria-labelledby="aiimg-c-prompt">
          <h3 id="aiimg-c-prompt">{{localize "AIIMG.Config.Prompt"}}</h3>
          <textarea name="promptTemplate" rows="5" aria-labelledby="aiimg-c-prompt">{{cfg.promptTemplate}}</textarea>
          <p class="hint">{{localize "AIIMG.Config.PromptHint"}}</p>
        </section>

        <section class="aiimg-card aiimg-refcard" aria-labelledby="aiimg-c-refs">
          <h3 id="aiimg-c-refs">{{localize "AIIMG.Config.Refs"}}</h3>
          {{#if refInfo.tiles}}
          <div class="aiimg-field">
            <span class="aiimg-lbl" id="aiimg-l-refp">{{localize "AIIMG.RefPurpose.Label"}}</span>
            <div class="aiimg-seg wrap" role="radiogroup" aria-labelledby="aiimg-l-refp" aria-describedby="aiimg-refp-hint">
              {{#each refInfo.purposes}}
              <label class="aiimg-seg-item" data-tooltip-text="{{hint}}">
                <input type="radio" name="refPurpose" value="{{id}}" {{#if selected}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
            <p class="hint" id="aiimg-refp-hint">{{refInfo.purposeHint}}</p>
          </div>
          <div class="aiimg-field aiimg-refmax">
            <label class="aiimg-lbl" for="aiimg-refmax">{{localize "AIIMG.RefSize.MaxEdge"}}</label>
            <select id="aiimg-refmax" name="refMaxEdge" {{#unless isGM}}disabled{{/unless}}>
              {{#each refInfo.maxEdges}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>
          <p class="hint">{{localize "AIIMG.RefSize.Rules"}}</p>
          {{else}}
          <p class="hint">{{localize "AIIMG.RefSize.GenericNote"}}</p>
          {{/if}}
          <div class="aiimg-refs" tabindex="0" aria-label="{{localize 'AIIMG.Config.Refs'}}">
            {{#each refs}}
            <figure class="aiimg-ref-row">
              <img src="{{path}}" alt="">
              <figcaption>
                <span class="aiimg-ref-size">{{text}}</span>
                {{#if warn}}<span class="aiimg-ref-warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{warn}}</span>{{/if}}
                {{#if @root.refInfo.tiles}}
                <select data-ref-purpose data-index="{{index}}" aria-label="{{localize 'AIIMG.RefPurpose.PerImage'}}" {{#unless @root.isGM}}disabled{{/unless}}>
                  {{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                {{/if}}
              </figcaption>
              <button type="button" data-action="removeRef" data-index="{{index}}" aria-label="{{localize 'AIIMG.Config.RemoveRef'}}" data-tooltip="AIIMG.Config.RemoveRef"><i class="fa-solid fa-xmark"></i></button>
            </figure>
            {{/each}}
            <div class="aiimg-ref-adds">
              <button type="button" class="aiimg-add" data-action="addRef" aria-label="{{localize 'AIIMG.Config.AddRef'}}" data-tooltip="AIIMG.Config.AddRef"><i class="fa-solid fa-plus"></i></button>
              {{#if isGM}}
              <button type="button" class="aiimg-add" data-action="uploadRefs" aria-label="{{localize 'AIIMG.Config.UploadRefsTip'}}" data-tooltip="AIIMG.Config.UploadRefsTip"><i class="fa-solid fa-upload"></i></button>
              <input type="file" name="refUpload" accept="image/*" multiple hidden>
              {{/if}}
            </div>
          </div>
          {{#if refInfo.total}}<p class="aiimg-ref-total" role="status">{{refInfo.total}}</p>{{/if}}
          {{#if isGM}}<p class="hint">{{localize "AIIMG.Config.RefsUploadHint"}}</p>{{/if}}
        </section>
      </div>
    </div>
    </div>

    {{!-- W6-G: depth settings (stored in cfg.depth, nothing reads them yet: every card says "coming soon"). --}}
    <div class="aiimg-tabpanel aiimg-depth" role="tabpanel" id="aiimg-panel-depth" aria-labelledby="aiimg-tab-depth" data-tab="depth" {{#unless tabDepth}}hidden{{/unless}}>
      <p class="aiimg-depth-banner" role="note"><i class="fa-solid fa-person-digging" aria-hidden="true"></i> <span>{{localize "AIIMG.Depth.Banner"}}</span></p>
      <div class="aiimg-cols">
        <div class="aiimg-col">
          <section class="aiimg-card" aria-labelledby="aiimg-c-dmain">
            <h3 id="aiimg-c-dmain">{{localize "AIIMG.Depth.CardMain"}} <em class="aiimg-tag aiimg-soon">{{localize "AIIMG.Depth.Soon"}}</em></h3>
            <div class="aiimg-field">
              <label class="aiimg-check">
                <input type="checkbox" name="depth.enabled" {{#if depth.enabled}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
                <span>{{localize "AIIMG.Depth.Enabled"}}</span>
              </label>
              <p class="hint">{{localize "AIIMG.Depth.EnabledHint"}}</p>
            </div>
          </section>

          <section class="aiimg-card" aria-labelledby="aiimg-c-dengine">
            <h3 id="aiimg-c-dengine">{{localize "AIIMG.Depth.CardEngine"}} <em class="aiimg-tag aiimg-soon">{{localize "AIIMG.Depth.Soon"}}</em></h3>
            <div class="aiimg-field">
              <span class="aiimg-lbl" id="aiimg-l-dengine">{{localize "AIIMG.Depth.Engine"}}</span>
              <div class="aiimg-seg" role="radiogroup" aria-labelledby="aiimg-l-dengine">
                {{#each depth.engines}}
                <label class="aiimg-seg-item">
                  <input type="radio" name="depth.engine" value="{{id}}" {{#if selected}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>
              {{#if depth.isBrowser}}
              <p class="hint" data-role="webgpu" data-state="{{#if depth.webgpu}}yes{{else}}no{{/if}}">{{depth.webgpuText}}</p>
              <label class="aiimg-check">
                <input type="checkbox" name="depth.fallback" {{#if depth.fallback}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
                <span>{{localize "AIIMG.Depth.Fallback"}}</span>
              </label>
              {{else}}
              <label class="aiimg-lbl" for="aiimg-dcomfy">{{localize "AIIMG.Depth.ComfyUrl"}}</label>
              <input id="aiimg-dcomfy" type="text" name="depth.comfyUrl" value="{{depth.comfyUrl}}" spellcheck="false" inputmode="url" aria-describedby="aiimg-dcomfy-hint" {{#unless isGM}}disabled{{/unless}}>
              <p class="hint" id="aiimg-dcomfy-hint">{{localize "AIIMG.Depth.ComfyUrlHint"}}</p>
              {{/if}}
            </div>

            <div class="aiimg-field">
              <span class="aiimg-lbl" id="aiimg-l-dmodel">{{localize "AIIMG.Depth.Model"}}</span>
              <div class="aiimg-depth-models" role="radiogroup" aria-labelledby="aiimg-l-dmodel">
                {{#each depth.models}}
                <label class="aiimg-depth-model">
                  <input type="radio" name="depth.model" value="{{key}}" {{#if selected}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                  <span class="aiimg-depth-model-body">
                    <span class="aiimg-depth-model-name"><strong>{{label}}</strong>{{#if isDefault}} <em class="aiimg-tag">{{localize "AIIMG.Depth.Default"}}</em>{{/if}}{{#if experimental}} <em class="aiimg-tag aiimg-exp">{{localize "AIIMG.Depth.Experimental"}}</em>{{/if}}</span>
                    <small class="aiimg-depth-id">{{id}}{{#if file}} · {{file}}{{/if}}</small>
                    <small>{{download}}</small>
                    <small>{{licence}} · {{speed}}</small>
                    <small class="aiimg-depth-note">{{note}}</small>
                  </span>
                </label>
                {{/each}}
              </div>
              {{#if depth.source}}<p class="hint"><a href="{{depth.source}}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{localize "AIIMG.Depth.ModelCard"}}: {{depth.sourceLabel}}</a></p>{{/if}}
              <p class="hint">{{localize "AIIMG.Depth.SizesNote"}}</p>
            </div>

            <div class="aiimg-field">
              <span class="aiimg-lbl" id="aiimg-l-dprec">{{localize "AIIMG.Depth.Precision"}}</span>
              <div class="aiimg-seg wrap" role="radiogroup" aria-labelledby="aiimg-l-dprec" aria-describedby="aiimg-dprec-hint">
                {{#each depth.precisions}}
                <label class="aiimg-seg-item{{#if disabled}} is-off{{/if}}" {{#if disabled}}data-tooltip="AIIMG.Config.NotForModel"{{/if}}>
                  <input type="radio" name="depth.precision" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>
              <p class="hint" id="aiimg-dprec-hint">{{localize "AIIMG.Depth.PrecisionHint"}}</p>
            </div>

            <div class="aiimg-field">
              <span class="aiimg-lbl" id="aiimg-l-dres">{{localize "AIIMG.Depth.Resolution"}}</span>
              <div class="aiimg-seg wrap" role="radiogroup" aria-labelledby="aiimg-l-dres" aria-describedby="aiimg-dres-hint">
                {{#each depth.resolutions}}
                <label class="aiimg-seg-item">
                  <input type="radio" name="depth.resolution" value="{{px}}" {{#if selected}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                  <span>{{label}}{{#if experimental}} <em class="aiimg-tag">{{localize "AIIMG.Depth.Experimental"}}</em>{{/if}}</span>
                </label>
                {{/each}}
              </div>
              <p class="hint" id="aiimg-dres-hint">{{localize "AIIMG.Depth.ResolutionHint"}}</p>
            </div>
          </section>
        </div>

        <div class="aiimg-col">
          <section class="aiimg-card" aria-labelledby="aiimg-c-dmask">
            <h3 id="aiimg-c-dmask">{{localize "AIIMG.Depth.CardMask"}} <em class="aiimg-tag aiimg-soon">{{localize "AIIMG.Depth.Soon"}}</em></h3>
            <div class="aiimg-field">
              <label class="aiimg-check">
                <input type="checkbox" name="depth.mask.enabled" {{#if depth.mask.enabled}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
                <span>{{localize "AIIMG.Depth.Mask"}}</span>
              </label>
              <p class="hint">{{localize "AIIMG.Depth.MaskHint"}}</p>
            </div>
            <div class="aiimg-field">
              <label class="aiimg-lbl" for="aiimg-dmaskm">{{localize "AIIMG.Depth.MaskModel"}}</label>
              <select id="aiimg-dmaskm" name="depth.mask.model" aria-describedby="aiimg-dmaskm-hint" {{#unless isGM}}disabled{{/unless}}>
                {{#each depth.masks}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
              <p class="hint" id="aiimg-dmaskm-hint" data-role="maskNote">{{depth.maskNote}}</p>
            </div>
          </section>

          <section class="aiimg-card" aria-labelledby="aiimg-c-dpost">
            <h3 id="aiimg-c-dpost">{{localize "AIIMG.Depth.CardPost"}} <em class="aiimg-tag aiimg-soon">{{localize "AIIMG.Depth.Soon"}}</em></h3>
            <div class="aiimg-field">
              <label class="aiimg-check">
                <input type="checkbox" name="depth.post.normalize" {{#if depth.post.normalize}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
                <span>{{localize "AIIMG.Depth.Normalize"}}</span>
              </label>
              <div class="aiimg-depth-pct">
                <label>{{localize "AIIMG.Depth.LowPct"}} <input type="number" name="depth.post.lowPct" value="{{depth.post.lowPct}}" min="{{depth.ranges.lowPct.[0]}}" max="{{depth.ranges.lowPct.[1]}}" step="{{depth.ranges.lowPct.[2]}}" {{#unless isGM}}disabled{{/unless}}></label>
                <label>{{localize "AIIMG.Depth.HighPct"}} <input type="number" name="depth.post.highPct" value="{{depth.post.highPct}}" min="{{depth.ranges.highPct.[0]}}" max="{{depth.ranges.highPct.[1]}}" step="{{depth.ranges.highPct.[2]}}" {{#unless isGM}}disabled{{/unless}}></label>
              </div>
            </div>
            {{#each depth.postToggles}}
            <div class="aiimg-field">
              <label class="aiimg-check">
                <input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
            </div>
            {{/each}}
            {{#each depth.postSliders}}
            {{> sliderRow}}
            {{/each}}
          </section>

          <section class="aiimg-card" aria-labelledby="aiimg-c-dout">
            <h3 id="aiimg-c-dout">{{localize "AIIMG.Depth.CardOutput"}} <em class="aiimg-tag aiimg-soon">{{localize "AIIMG.Depth.Soon"}}</em></h3>
            <div class="aiimg-field">
              <span class="aiimg-lbl" id="aiimg-l-dfmt">{{localize "AIIMG.Depth.Format"}}</span>
              <div class="aiimg-seg" role="radiogroup" aria-labelledby="aiimg-l-dfmt" aria-describedby="aiimg-dfmt-hint">
                {{#each depth.outputs}}
                <label class="aiimg-seg-item">
                  <input type="radio" name="depth.output.format" value="{{id}}" {{#if selected}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>
              <p class="hint" id="aiimg-dfmt-hint">{{localize "AIIMG.Depth.FormatHint"}}</p>
            </div>
            <div class="aiimg-field">
              <label class="aiimg-check">
                <input type="checkbox" name="depth.output.maskChannel" {{#if depth.output.maskChannel}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
                <span>{{localize "AIIMG.Depth.MaskChannel"}}</span>
              </label>
            </div>
          </section>

          <section class="aiimg-card" aria-labelledby="aiimg-c-dpar">
            <h3 id="aiimg-c-dpar">{{localize "AIIMG.Depth.CardParallax"}} <em class="aiimg-tag aiimg-soon">{{localize "AIIMG.Depth.Soon"}}</em></h3>
            {{#each depth.parallaxSliders}}
            {{> sliderRow}}
            {{/each}}
            <div class="aiimg-depth-toggles">
              {{#each depth.parallaxToggles}}
              <label class="aiimg-check">
                <input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}} {{#unless @root.isGM}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
          </section>
        </div>
      </div>
    </div>

    {{#if isGM}}
    <footer class="aiimg-footer">
      <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> {{localize "AIIMG.Config.Reset"}}</button>
      <button type="button" data-action="save" class="primary"><i class="fa-solid fa-floppy-disk"></i> {{localize "AIIMG.Config.Save"}}</button>
    </footer>
    {{/if}}
    {{/if}}
  </form>
</section>
