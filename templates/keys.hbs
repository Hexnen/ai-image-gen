<div class="aiimg-keys-part">
<div class="aiimg-keys-body">
  <p class="hint aiimg-keys-lead"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize "AIIMG.Keys.Lead"}}</p>
  {{#each keys}}
  <div class="form-group">
    <label for="{{id}}">{{label}}</label>
    <div class="form-fields">
      <input type="password" id="{{id}}" name="{{name}}" value="{{value}}" autocomplete="off" spellcheck="false" autocapitalize="off" data-1p-ignore data-lpignore="true" data-bwignore>
      <button type="button" class="aiimg-keys-reveal icon fa-solid fa-eye" data-action="reveal" data-target="{{name}}" aria-label="{{../show}}" aria-pressed="false" aria-controls="{{id}}" data-tooltip="{{../show}}"></button>
    </div>
    {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}
  </div>
  {{/each}}
  {{#if prewarm}}
  <div class="form-group">
    <label for="{{prewarm.id}}">{{prewarm.label}}</label>
    <div class="form-fields"><input type="checkbox" id="{{prewarm.id}}" name="{{prewarm.name}}" {{#if prewarm.checked}}checked{{/if}}></div>
    <p class="hint">{{prewarm.hint}}</p>
  </div>
  {{/if}}
</div>
<footer class="form-footer">
  <button type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "AIIMG.Keys.Save"}}</button>
</footer>
</div>
